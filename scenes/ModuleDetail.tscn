[gd_scene load_steps=2 format=3 uid="uid://module_detail"]

[ext_resource type="Script" path="res://scripts/ui/module_detail.gd" id="1_module_detail"]

[node name="ModuleDetail" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_module_detail")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.04, 0.08, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_right = -24.0
offset_top = 24.0
offset_bottom = -24.0
add_theme_constant_override/separation = 16

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2
add_theme_constant_override/separation = 14

[node name="BackButton" type="Button" parent="VBox/Header"]
layout_mode = 2
custom_minimum_size = Vector2(90, 56)
text = "←"

[node name="ModuleTitle" type="Label" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
text = "Módulo"
add_theme_font_size_override/font_size = 32
add_theme_color_override/font_color = Color(0.29, 0.56, 1.0, 1)
autowrap_mode = 3

[node name="ModuleDesc" type="Label" parent="VBox"]
layout_mode = 2
text = ""
add_theme_font_size_override/font_size = 22
add_theme_color_override/font_color = Color(0.5, 0.55, 0.7, 1)
autowrap_mode = 3

[node name="HSeparator" type="HSeparator" parent="VBox"]
layout_mode = 2
add_theme_color_override/separator = Color(0.18, 0.2, 0.32, 0.3)

[node name="ScrollContainer" type="ScrollContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="LessonsContainer" type="VBoxContainer" parent="VBox/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
add_theme_constant_override/separation = 0

[node name="ExamButton" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 90)
text = "📝  Ir al Examen"
add_theme_font_size_override/font_size = 28

[connection signal="pressed" from="VBox/Header/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="VBox/ExamButton" to="." method="_on_exam_pressed"]
